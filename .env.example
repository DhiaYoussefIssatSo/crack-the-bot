# Copie ce fichier en « .env » pour changer un réglage. Tout est optionnel : sans .env, les valeurs ci-dessous
# (sauf mention contraire) sont celles par défaut. Pas d'espaces autour du « = ».
# Le jeu (./run.sh) ET les outils tools/check_model.py, tune.py et redteam.py lisent ce fichier.

# --- Modèle ---------------------------------------------------------------
BACKEND=ollama            # « ollama » pour le vrai jeu, « mock » pour essayer l'interface sans modèle
MODEL=qwen2.5:3b          # à choisir avec tools/check_model.py puis tools/redteam.py (voir GUIDE_TESTS.md)
OLLAMA_URL=http://127.0.0.1:11434
TEMPERATURE=0.4
MAX_TOKENS=80             # longueur maximale d'une réponse ; plus petit = plus rapide (essaie 50 si l'attente est trop longue)
NUM_CTX=1024              # petite fenêtre de contexte : plus rapide et moins gourmand en mémoire
REQUEST_TIMEOUT=60        # secondes avant d'abandonner une réponse du modèle (mets 90 si le PC est lent)

# --- Vitesse (tools/tune.py te dit quoi mettre ; laisse vide/défaut si tu ne l'as pas lancé) -----------
THINK=off                 # off = pas de mode « réflexion » (nécessaire pour Qwen3/Qwen3.5/Gemma 4). default = ne rien envoyer
NUM_THREAD=0              # threads de calcul ; 0 = Ollama décide
NUM_GPU=-1                # couches sur la carte graphique ; -1 = Ollama décide, 0 = processeur seulement
KEEP_ALIVE=24h            # le modèle reste chargé en mémoire (« 24h », « 90m », ou -1 = jamais déchargé)

# --- Règles ---------------------------------------------------------------
TIME_LIMIT=180            # secondes par joueur
WRONG_GUESS_PENALTY=10    # secondes perdues par mot faux dans « Valider »
MESSAGES_PER_LEVEL=6      # messages que le joueur peut envoyer au gardien, par niveau (le serveur compte)
# HISTORY_TURNS=6         # normalement ABSENT : par défaut = MESSAGES_PER_LEVEL (le gardien se souvient de tout le niveau).
#                         # Une valeur plus petite fait glisser l'historique et ralentit gemma3 (cache perdu). 0 = pas de mémoire.
MAX_MESSAGE_CHARS=300
POINTS_PER_LEVEL=1000

# --- Serveur --------------------------------------------------------------
HOST=127.0.0.1            # 0.0.0.0 seulement si une autre machine doit ouvrir /board (voir README)
PORT=8000
ADMIN_TOKEN=              # vide = un jeton aléatoire est généré et affiché à chaque lancement
DATA_DIR=./data           # le classement est sauvegardé dans DATA_DIR/leaderboard.json
